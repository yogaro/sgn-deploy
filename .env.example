# Copy to .env (next to compose.yaml). Real values stay in .env only.
# Letters and digits only: the password is also embedded in the services' DATABASE_URL.
POSTGRES_USER=sgn
POSTGRES_PASSWORD=

# Host ports. Change them if your local dev servers already use these.
PORTAL_PORT=3000
LMS_WEB_PORT=3003
DIRECTORY_FE_PORT=3001
DIRECTORY_PORT=8080
IAM_PORT=8081
HR_PORT=8082
POSTGRES_PORT=55432

# IAM: Ed25519 seed from `docker run --rm sgn-iam-service genkey` (see docker/README.md).
IAM_SIGNING_KEY_FILE=./docker/secrets/iam-signing-key.txt
IAM_SIGNING_KEY_ID=1
# Service key IAM uses to pull from the directory service (createserviceclient in the directory image).
DIRECTORY_SERVICE_KEY=

# HR pulls units/employees from IAM with this client (createserviceclient in the IAM image).
HR_IAM_CLIENT_ID=
HR_IAM_CLIENT_SECRET=
HR_IAM_SYNC_INTERVAL=1h

# LMS pulls units/employees from IAM with this client (createserviceclient in the IAM image).
LMS_IAM_CLIENT_ID=
LMS_IAM_CLIENT_SECRET=
LMS_IAM_SYNC_INTERVAL=1h
LMS_PORT=8083
# Object store for course media (RustFS, S3-compatible). Letters and digits only, 12+ characters.
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Address people open the site at; signed media URLs carry it. Change it when sharing over HTTPS.
LMS_PUBLIC_URL=http://localhost:3003

# Keep false over plain http://localhost; true behind HTTPS.
COOKIE_SECURE=false

# Monitoring (docker compose --profile monitoring up -d). Grafana logs in as admin with this password.
GRAFANA_ADMIN_PASSWORD=
GRAFANA_PORT=3002
PROMETHEUS_PORT=9090
