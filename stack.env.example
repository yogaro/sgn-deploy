# Environment for compose.stack.yaml (panel stack deploy). Paste into the panel's environment variables, or keep as .env.
# Secrets: letters and digits only (they end up in URLs). Generate each with:  openssl rand -hex 24
# The signing key is different:                                               openssl rand -base64 32

# Images (.github/workflows/images.yml). Pin IMAGE_TAG to a commit SHA for a reproducible deploy.
REGISTRY=ghcr.io/yogaro
IMAGE_TAG=latest

# Public host names (DNS A records -> server); TLS by the reverse proxy in front.
PORTAL_DOMAIN=
LMS_DOMAIN=
DIRECTORY_DOMAIN=

POSTGRES_USER=sgn
POSTGRES_PASSWORD=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# IAM token signing key (base64 of 32 random bytes). Changing it signs everyone out.
IAM_SIGNING_KEY=

# Service credentials; the bootstrap job writes them into IAM and Directory on every deploy.
HR_IAM_CLIENT_SECRET=
LMS_IAM_CLIENT_SECRET=
DIRECTORY_SERVICE_KEY=

# First accounts, created once by the bootstrap job (later password changes in the apps are kept).
# IAM superadmin: signs in to the Portal and SUGARLedge with ADMIN_LOGIN.
ADMIN_LOGIN=SUPERADMIN
ADMIN_PASSWORD=
# Directory FE sign-in (email + password).
DIRECTORY_ADMIN_EMAIL=
DIRECTORY_ADMIN_PASSWORD=

# Loopback ports the reverse proxy points at (docker/runcloud/*.conf).
PORTAL_PORT=3000
LMS_WEB_PORT=3003
DIRECTORY_FE_PORT=3001
DIRECTORY_PORT=8080
