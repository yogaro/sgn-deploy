{
  "uid": "sgn-worker",
  "title": "SGN · Worker & Sync",
  "description": "Job harian, sync IAM, dan antrean penugasan LMS.",
  "tags": [
    "sgn"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "type": "row",
      "title": "Kesehatan job",
      "id": 1,
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "bargauge",
      "title": "Sukses terakhir (sejak)",
      "description": "Job harian jalan pukul 01.00 WIB; sync IAM tiap jam. Oranye > 3 jam, merah > 26 jam.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sort(time() - worker_job_last_success_timestamp_seconds)",
          "legendFormat": "{{job}} · {{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 10800
              },
              {
                "color": "red",
                "value": 93600
              }
            ]
          },
          "min": 0,
          "max": 93600
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "displayMode": "basic",
        "showUnfilled": true,
        "valueMode": "color",
        "namePlacement": "left",
        "sizing": "manual",
        "minVizHeight": 18,
        "maxVizHeight": 22
      },
      "id": 2,
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Hasil job per jam",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, task, result) (increase(worker_job_runs_total[1h]))",
          "legendFormat": "{{job}} · {{task}} · {{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 3,
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 11
      }
    },
    {
      "type": "timeseries",
      "title": "Durasi rata-rata job",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, task) (rate(worker_job_duration_seconds_sum[1h])) / sum by (job, task) (rate(worker_job_duration_seconds_count[1h]))",
          "legendFormat": "{{job}} · {{task}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
