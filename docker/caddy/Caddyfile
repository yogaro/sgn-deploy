# Public entry point. Caddy gets and renews the Let's Encrypt certificates itself.

# Portal at /, SUGARLedge at /lms/ on the same host, so both share IAM's SameSite=Strict refresh cookie.
{$SGN_DOMAIN} {
	encode zstd gzip

	@lms path /lms /lms/* /api/lms/* /lms-files/*
	handle @lms {
		# Course videos and PDFs go up to 600 MB, as in the lms-fe nginx.
		request_body {
			max_size 600MB
		}
		reverse_proxy lms-fe:80 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy portal:80
	}
}

# Directory FE, with its API under /api on the same host so no cross-site cookie is needed.
{$DIRECTORY_DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy directory:8080
	}

	handle {
		reverse_proxy directory-fe:80
	}
}
