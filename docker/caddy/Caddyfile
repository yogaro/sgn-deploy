# Public entry point. Caddy gets and renews the Let's Encrypt certificates itself.
# One host per app; each frontend's nginx proxies its own /api/* to the backends, so every call stays same-origin.

# Portal (IAM admin, HR).
{$PORTAL_DOMAIN} {
	encode zstd gzip
	reverse_proxy portal:80
}

# SUGARLedge. The app lives under /lms/; the lms-fe nginx redirects / there.
{$LMS_DOMAIN} {
	encode zstd gzip
	request_body {
		# Course videos and PDFs go up to 600 MB, as in the lms-fe nginx.
		max_size 600MB
	}
	reverse_proxy lms-fe:80 {
		flush_interval -1
	}
}

# Directory FE, with its API under /api on the same host so no cross-site cookie is needed.
{$DIRECTORY_DOMAIN} {
	encode zstd gzip

	handle_path /api/* {
		reverse_proxy directory:8080
	}

	handle {
		reverse_proxy directory-fe:80
	}
}
